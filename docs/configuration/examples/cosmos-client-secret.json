{
  "services": {
    "dynamodb": {
      "enabled": true,
      "useStoredProcedures": "Preferred",
      "consistencyCheck": "Required",
      "cosmosBinaryResponses": false,
      "cosmosBinaryRequests": false,
      "enableGlobalSecondaryIndexQueries": false,
      "enableLocalSecondaryIndexNumericOrdering": false
    }
  },
  "bindings": [
    {
      "aws": {
        "accessKeyId": "AKIAPRODCOSMOS",
        "secretAccessKey": "replace-with-aws-signing-secret"
      },
      "azure": {
        "dynamodb": {
          "kind": "cosmos",
          "target": {
            "endpoint": "https://prod-orders.documents.azure.com/",
            "databaseName": "orders",
            "preferredRegions": [
              "East US",
              "West US"
            ]
          },
          "auth": {
            "mode": "clientSecret",
            "tenantId": "00000000-0000-0000-0000-000000000000",
            "clientId": "11111111-1111-1111-1111-111111111111",
            "clientSecret": "replace-with-entra-client-secret"
          }
        }
      }
    }
  ]
}
