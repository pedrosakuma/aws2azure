        },
        "partitionCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "services"
        ],
        "properties": {
          "services": {
            "required": [
              "sns"
            ],
            "properties": {
              "sns": {
                "required": [
                  "defaultBackend"
                ],
                "properties": {
                  "defaultBackend": {
                    "const": "EventGrid"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "bindings": {
            "items": {
              "if": {
