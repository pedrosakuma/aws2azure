                        ],
                        "properties": {
                          "kind": {
                            "const": "serviceBusTopics"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "azure": {
                    "properties": {
                      "sns": {
