            "eventGridTopicEndpoint",
            "eventGridAccessKey"
          ]
        }
      ]
    },
    "streamSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eventHubName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "consumerGroup": {
