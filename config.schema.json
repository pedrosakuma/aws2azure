            "eventGridTopicEndpoint": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://(?:(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?::(?:[0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\s]*)?$"
            },
            "eventGridAccessKey": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "required": [
