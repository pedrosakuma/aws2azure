<Project>
  <UsingTask
    TaskName="GenerateWorkloadGaEvaluatorIdentity"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <CompileFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <RepositoryRoot ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
      <IntermediateRootMarkerFile ParameterType="System.String" Required="true" />
      <ToolRoot ParameterType="System.String" Required="true" />
      <Revision ParameterType="System.String" Output="true" />
      <GeneratedIntermediateFiles
        ParameterType="Microsoft.Build.Framework.ITaskItem[]"
        Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var root = Path.GetFullPath(RepositoryRoot);
        Func<string, string> relative = path =>
            Path.GetFullPath(path)
                .Substring(root.TrimEnd('\\', '/').Length)
                .TrimStart('\\', '/')
                .Replace('\\', '/');
        var pathComparison = Path.DirectorySeparatorChar == '\\'
            ? StringComparison.OrdinalIgnoreCase
            : StringComparison.Ordinal;
        const string markerFileName =
            ".workload-ga-evaluator-intermediate-root";
        const string markerContent =
            "aws2azure-gapdocs-evaluator-identity-root:v1\n";
        var markerFile = Path.GetFullPath(IntermediateRootMarkerFile);
        Directory.CreateDirectory(Path.GetDirectoryName(markerFile));
        if (!File.Exists(markerFile)
            || !File.ReadAllText(markerFile).Equals(
                markerContent,
                StringComparison.Ordinal))
        {
            File.WriteAllText(
                markerFile,
                markerContent,
                new UTF8Encoding(false));
        }
        var inputFiles = Files
            .Select(file => Path.GetFullPath(file.ItemSpec))
            .Distinct(pathComparison == StringComparison.OrdinalIgnoreCase
                ? StringComparer.OrdinalIgnoreCase
                : StringComparer.Ordinal)
            .ToList();
        var generatedIntermediateRoots = Directory
            .EnumerateFiles(
                Path.GetFullPath(ToolRoot),
                markerFileName,
                SearchOption.AllDirectories)
            .Where(path => File.ReadAllText(path).Equals(
                markerContent,
                StringComparison.Ordinal))
            .Select(path => Path.GetDirectoryName(path))
            .Where(path => path is not null)
            .Select(path => Path.GetFullPath(path))
            .Distinct(pathComparison == StringComparison.OrdinalIgnoreCase
                ? StringComparer.OrdinalIgnoreCase
                : StringComparer.Ordinal)
            .ToList();
        Func<string, string, bool> isWithin = (directory, path) =>
            path.Equals(directory, pathComparison)
            || path.StartsWith(
                directory.TrimEnd('\\', '/') + Path.DirectorySeparatorChar,
                pathComparison);
        var activeIntermediateRoot = Path.GetDirectoryName(
            Path.GetFullPath(OutputFile));
        GeneratedIntermediateFiles = CompileFiles
            .Where(file =>
            {
                var compilePath = Path.GetFullPath(file.ItemSpec);
                return generatedIntermediateRoots.Any(
                    directory => !directory.Equals(
                        activeIntermediateRoot,
                        pathComparison)
                        && isWithin(directory, compilePath)
                        && !(isWithin(directory, activeIntermediateRoot)
                            && isWithin(activeIntermediateRoot, compilePath)));
            })
            .ToArray();
        using var hash = IncrementalHash.CreateHash(HashAlgorithmName.SHA256);
        var outputFile = Path.GetFullPath(OutputFile);
        foreach (var item in inputFiles
                     .Where(path => !path.Equals(
                         outputFile,
                         pathComparison)
                         && !generatedIntermediateRoots.Any(
                             directory => isWithin(directory, path)))
                     .OrderBy(
                         path => relative(path),
                         StringComparer.Ordinal))
        {
            var relativePath = relative(item);
            hash.AppendData(Encoding.UTF8.GetBytes(relativePath));
            hash.AppendData(Encoding.UTF8.GetBytes("\n"));
            var content = File.ReadAllText(item)
                .Replace("\r\n", "\n")
                .Replace("\r", "\n");
            hash.AppendData(Encoding.UTF8.GetBytes(content));
            hash.AppendData(Encoding.UTF8.GetBytes("\n\0"));
        }

        Revision = "sha256:" + BitConverter.ToString(hash.GetHashAndReset())
            .Replace("-", string.Empty)
            .ToLowerInvariant();
        var generated =
            "// <auto-generated />\n" +
            "namespace Aws2Azure.GapDocs;\n\n" +
            "internal static class WorkloadGaEmbeddedEvaluatorIdentity\n" +
            "{\n" +
            $"    internal const string Revision = \"{Revision}\";\n" +
            "}\n";
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        if (!File.Exists(OutputFile)
            || !File.ReadAllText(OutputFile).Equals(generated, StringComparison.Ordinal))
        {
            File.WriteAllText(OutputFile, generated, new UTF8Encoding(false));
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateWorkloadGaEvaluatorIdentity" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_WorkloadGaEvaluatorIdentityDirectory>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)', '$(MSBuildProjectDirectory)'))</_WorkloadGaEvaluatorIdentityDirectory>
      <_WorkloadGaEvaluatorIdentityFile>$(_WorkloadGaEvaluatorIdentityDirectory)/WorkloadGaEvaluatorIdentity.g.cs</_WorkloadGaEvaluatorIdentityFile>
      <_WorkloadGaEvaluatorIdentityMarkerFile>$(_WorkloadGaEvaluatorIdentityDirectory)/.workload-ga-evaluator-intermediate-root</_WorkloadGaEvaluatorIdentityMarkerFile>
    </PropertyGroup>
    <ItemGroup>
      <_WorkloadGaEvaluatorIdentityInput
        Include="$(MSBuildProjectDirectory)/**/*.cs"
        Exclude="$(MSBuildProjectDirectory)/bin/**;$(MSBuildProjectDirectory)/obj/**;$(_WorkloadGaEvaluatorIdentityDirectory)/**;$(_WorkloadGaEvaluatorIdentityFile)" />
      <_WorkloadGaEvaluatorIdentityInput
        Include="$(MSBuildProjectFullPath);$(MSBuildProjectDirectory)/GenerateEvaluatorIdentity.targets;$(MSBuildProjectDirectory)/../../Directory.Build.props;$(MSBuildProjectDirectory)/../../global.json" />
    </ItemGroup>
    <GenerateWorkloadGaEvaluatorIdentity
      Files="@(_WorkloadGaEvaluatorIdentityInput)"
      CompileFiles="@(Compile)"
      RepositoryRoot="$(MSBuildProjectDirectory)/../.."
      OutputFile="$(_WorkloadGaEvaluatorIdentityFile)"
      IntermediateRootMarkerFile="$(_WorkloadGaEvaluatorIdentityMarkerFile)"
      ToolRoot="$(MSBuildProjectDirectory)">
      <Output TaskParameter="Revision" PropertyName="WorkloadGaEvaluatorImplementationRevision" />
      <Output
        TaskParameter="GeneratedIntermediateFiles"
        ItemName="_WorkloadGaGeneratedIntermediateCompile" />
    </GenerateWorkloadGaEvaluatorIdentity>
    <ItemGroup>
      <Compile Remove="@(_WorkloadGaGeneratedIntermediateCompile)" />
      <Compile Remove="$(_WorkloadGaEvaluatorIdentityFile)" />
      <Compile
        Include="$(_WorkloadGaEvaluatorIdentityFile)"
        AutoGen="true"
        DesignTime="true"
        Visible="false" />
    </ItemGroup>
  </Target>
</Project>
